# Configuration du client SantéPlus Secure (Expo)
#
# ATTENTION : Les variables préfixées par EXPO_PUBLIC_* sont
# injectées textuellement dans le bundle JavaScript au build.
# ELLES NE SONT PAS SECRÈTES !
#
# Seules des informations NON sensibles (URLs d'API publiques)
# doivent figurer ici. AUCUNE CLÉ PRIVÉE, AUCUN TOKEN.

# URL de l'API (HTTPS OBLIGATOIRE — HTTP interdit)
# En dev local : http://localhost:3000/v1 (ou votre IP locale pour appareil physique)
# En prod      : https://api.santeplus.ma/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

#  NE PAS METTRE ICI :
# - GOOGLE_MAPS_API_KEY (gérée par le proxy backend dans server/.env)
# - JWT_SECRET (gérée par le backend dans server/.env)
# - Mot de passe de base de données

