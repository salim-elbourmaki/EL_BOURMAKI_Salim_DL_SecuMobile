# Configuration du serveur Mock SantéPlus (SECRETS CÔTÉ SERVEUR)
#
# Ce fichier contient les vrais secrets qui ne doivent JAMAIS
# être présents dans l'application mobile (APK / IPA).

PORT=3000

# Secret cryptographique pour signer les JWT (HMAC-SHA256)
# En production : générer avec `openssl rand -base64 64`
JWT_SECRET=votre-cle-secrete-jwt-ultra-longue-et-aleatoire-min-64-caracteres-pour-production

# Clé API Google Maps (Geocoding)
# Restée côté serveur pour éviter son extraction depuis l'APK (vuln #2)
GOOGLE_MAPS_API_KEY=AIzaSyD-votre-vraie-cle-avec-restrictions-gcp

